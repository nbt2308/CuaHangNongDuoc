        private ToolStripMenuItem mnuTaiKhoan, mnuDoiMatKhau, mnuDangXuat;

        private void GanMenuTaiKhoan()
        {
            mnuTaiKhoan = new ToolStripMenuItem("Quản lý tài khoản");
            mnuTaiKhoan.Click += (sender, e) => {
                if (!AuthorizationService.KiemTraVaThongBao(AuthorizationService.Permission.QuanLyTaiKhoan)) return;
                using (var frm = new frmQuanLyTaiKhoan()) frm.ShowDialog(this);
            };
            mnuDoiMatKhau = new ToolStripMenuItem("Đổi mật khẩu");
            mnuDoiMatKhau.Click += (sender, e) => {
                if (!AuthorizationService.KiemTraVaThongBao(AuthorizationService.Permission.DoiMatKhau)) return;
                using (var frm = new frmDoiMatKhau()) frm.ShowDialog(this);
            };
            mnuDangXuat = new ToolStripMenuItem("Đăng xuất");
            mnuDangXuat.Click += (sender, e) => {
                UserSession.Logout();
                this.Close(); // Đóng hoàn toàn, yêu cầu mở lại và đăng nhập
            };
            mnuHeThong.DropDownItems.Insert(0, mnuTaiKhoan);
            mnuHeThong.DropDownItems.Insert(1, mnuDoiMatKhau);
            mnuHeThong.DropDownItems.Insert(2, mnuDangXuat);
            this.Text += " — " + UserSession.HoTen + " (" + UserSession.RoleDisplayName + ")";
        }

