using System;
using System.Drawing;
using System.Windows.Forms;
using CuahangNongduoc.Auth;

namespace CuahangNongduoc
{
    /// <summary>
    /// Form đăng nhập hệ thống.
    /// Thực hiện xác thực tài khoản, kiểm tra trạng thái và phiên đăng nhập.
    /// </summary>
    public partial class frmDangNhap : Form
    {
        private readonly AuthenticationService _authService;

        // Kết quả sau khi đóng form: true = đăng nhập thành công
        public bool DangNhapThanhCong { get; private set; }

        // Tài khoản vừa đăng nhập thành công (để xử lý MustChangePwd)
        public Auth.NguoiDung NguoiDungDangNhap { get; private set; }

        public frmDangNhap()
        {
            InitializeComponent();
            _authService = new AuthenticationService();
            DangNhapThanhCong = false;
        }

        private void frmDangNhap_Load(object sender, EventArgs e)
        {
            // Focus vào textbox tên đăng nhập
            txtTenDangNhap.Focus();
        }

        private void btnDangNhap_Click(object sender, EventArgs e)
        {
            ThucHienDangNhap();
        }

        private void btnThoat_Click(object sender, EventArgs e)
        {
            DangNhapThanhCong = false;
            this.Close();
        }

        // Cho phép nhấn Enter để đăng nhập
        private void txtMatKhau_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
            {
                e.SuppressKeyPress = true;
                ThucHienDangNhap();
            }
        }

        private void txtTenDangNhap_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
            {
                e.SuppressKeyPress = true;
                txtMatKhau.Focus();
            }
        }

        private void chkHienMatKhau_CheckedChanged(object sender, EventArgs e)
        {
            txtMatKhau.UseSystemPasswordChar = !chkHienMatKhau.Checked;
        }

        private void ThucHienDangNhap()
        {
            // Xóa thông báo lỗi cũ
            lblThongBao.Text = "";
            lblThongBao.Visible = false;

            // Kiểm tra dữ liệu đầu vào
            if (string.IsNullOrWhiteSpace(txtTenDangNhap.Text))
            {
                HienThiLoi("Vui lòng nhập tên đăng nhập.");
                txtTenDangNhap.Focus();
                return;
            }

            if (string.IsNullOrEmpty(txtMatKhau.Text))
            {
                HienThiLoi("Vui lòng nhập mật khẩu.");
                txtMatKhau.Focus();
                return;
            }

            // Vô hiệu hóa nút trong khi xử lý
            btnDangNhap.Enabled = false;
            btnThoat.Enabled = false;
            this.Cursor = Cursors.WaitCursor;

            try
            {
                Auth.NguoiDung nguoiDung;
                LoginResult ketQua = _authService.DangNhap(
                    txtTenDangNhap.Text.Trim(),
                    txtMatKhau.Text,
                    out nguoiDung);

                switch (ketQua)
                {
                    case LoginResult.Success:
                        NguoiDungDangNhap = nguoiDung;
                        DangNhapThanhCong = true;
                        this.DialogResult = DialogResult.OK;
                        this.Close();
                        break;

                    case LoginResult.MustChangePwd:
                        NguoiDungDangNhap = nguoiDung;
                        DangNhapThanhCong = true;
                        MessageBox.Show(
                            "Đăng nhập thành công!\n\nTài khoản của bạn yêu cầu đổi mật khẩu.\nVui lòng đổi mật khẩu ngay sau khi vào hệ thống.",
                            "Yêu cầu đổi mật khẩu",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information);
                        this.DialogResult = DialogResult.OK;
                        this.Close();
                        break;

                    case LoginResult.AccountLocked:
                        HienThiLoi("Tài khoản này đã bị khóa. Vui lòng liên hệ quản trị viên.");
                        break;

                    case LoginResult.InvalidCredentials:
                        HienThiLoi("Tên đăng nhập hoặc mật khẩu không đúng.");
                        // Xóa mật khẩu để người dùng nhập lại
                        txtMatKhau.Clear();
                        txtMatKhau.Focus();
                        break;

                    case LoginResult.DatabaseError:
                        HienThiLoi("Không thể kết nối cơ sở dữ liệu. Vui lòng kiểm tra lại.");
                        break;

                    default:
                        HienThiLoi("Đã xảy ra lỗi không xác định. Vui lòng thử lại.");
                        break;
                }
            }
            catch (Exception ex)
            {
                HienThiLoi("Lỗi hệ thống: " + ex.Message);
            }
            finally
            {
                btnDangNhap.Enabled = true;
                btnThoat.Enabled = true;
                this.Cursor = Cursors.Default;
            }
        }

        private void HienThiLoi(string thongBao)
        {
            lblThongBao.Text = thongBao;
            lblThongBao.Visible = true;
        }
    }
}
